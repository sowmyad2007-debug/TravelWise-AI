# ===================================================================
# TravelWise AI+ Environment Configuration Template
# NOTE: Copy this file to '.env' and customize values. Never commit actual secrets!
# ===================================================================

# Application Security
SECRET_KEY=replace-with-a-random-secure-string-for-jwt-and-session-signing

# Server Configuration
PORT=5000
DEBUG=True

# Database Configuration (Defaults to backend/travelwise.db SQLite database)
DATABASE_PATH=backend/travelwise.db

# Authentication Settings
JWT_EXPIRATION_HOURS=24
RESET_TOKEN_EXPIRATION_MINUTES=60

# Optional: Google Gemini Language Model API Key
# If omitted or empty, TravelWise AI+ seamlessly runs the built-in Adaptive Heuristic Engine (Demo Mode).
# When provided, connects to live Gemini 2.5 Flash for conversational intelligence.
GEMINI_API_KEY=
