# ===================================================================
# TravelWise AI+ Frontend Environment Variables
# ===================================================================
# In development (npm run dev):
#   Leave blank. The Vite dev server automatically proxies /api requests to http://127.0.0.1:5000.
#
# In production (deployed on Vercel):
#   Set this variable in your Vercel Project Settings -> Environment Variables.
#   It must point to your deployed backend API URL (e.g., hosted on Render, Railway, etc.)
#
# Example Render URL:
#   VITE_API_BASE_URL=https://travelwise-backend.onrender.com/api
# ===================================================================

VITE_API_BASE_URL=
